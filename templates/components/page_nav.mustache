{{!
  @template local_coursetransfermanager/components/page_nav

  Shared footer navigation for every manager screen: back to the panel and
  the manager settings.

  Context variables:
  * panel    - string, URL of the management panel (optional; hidden when empty)
  * settings - string, URL of the manager settings (optional; hidden when empty)

  Example context (json):
  {
    "panel": "#",
    "settings": "#"
  }
}}
<div class="ct-pagenav">
    {{#panel}}
    <a class="ct-btn ct-btn--secondary ct-btn--sm" href="{{ panel }}">
        <i class="fa fa-calendar" aria-hidden="true"></i>
        {{#str}} managetasks, local_coursetransfermanager {{/str}}
    </a>
    {{/panel}}
    {{#settings}}
    <a class="ct-btn ct-btn--secondary ct-btn--sm" href="{{ settings }}">
        <i class="fa fa-cog" aria-hidden="true"></i>
        {{#str}} settings_link, local_coursetransfermanager {{/str}}
    </a>
    {{/settings}}
</div>
