{{!
  @template local_coursetransfermanager/components/page_header

  Shared page hero: plugin icon + page title + description. The title lives
  here (the theme heading is cleared with set_heading('') to avoid a
  duplicate h1). Wrap it in a .ct-hero and put page actions in .ct-hero-side.

  Context variables:
  * headertitle - string, the page title (required)
  * headerdesc  - string, one-line description (optional)

  Example context (json):
  { "headertitle": "Transferencias programadas", "headerdesc": "Archivo anual automático de categorías…" }
}}
<div class="ct-hero-main">
    <span class="ct-page-icon">{{#pix}} icon, local_coursetransfermanager {{/pix}}</span>
    <div class="ct-hero-text">
        <h1 class="ct-hero-title">{{ headertitle }}</h1>
        {{#headerdesc}}<p class="ct-hero-desc">{{ headerdesc }}</p>{{/headerdesc}}
    </div>
</div>
