{{!
  @template local_coursetransfermanager/components/health_checks

  Prerequisite health strip: one chip per check with tone + detail and an
  optional action link. The sites check never runs live tests — it shows the
  last result registered by CourseTransfer and links there.

  Context variables:
  * checks - array of {key, isok, iswarning, iserror, label, detail, actionurl, actionlabel}

  Example context (json):
  {
    "checks": [
      {"key": "cron", "isok": true, "label": "Cron de Moodle", "detail": "Última pasada hace 3 min"}
    ]
  }
}}
<div class="ct-checks" role="status">
    {{#checks}}
    <div class="ct-check {{#iswarning}}ct-check--warning{{/iswarning}}{{#iserror}}ct-check--error{{/iserror}}">
        <span class="ct-check-dot" aria-hidden="true">
            {{#isok}}<i class="fa fa-check" aria-hidden="true"></i>{{/isok}}
            {{#iswarning}}<i class="fa fa-exclamation" aria-hidden="true"></i>{{/iswarning}}
            {{#iserror}}<i class="fa fa-times" aria-hidden="true"></i>{{/iserror}}
        </span>
        <span class="ct-check-body">
            <span class="ct-check-label">{{ label }}</span>
            <span class="ct-check-detail">{{ detail }}</span>
        </span>
        {{#actionurl}}
        <a class="ct-check-action" href="{{ actionurl }}" title="{{ actionlabel }}" aria-label="{{ actionlabel }}">
            <i class="fa fa-arrow-right" aria-hidden="true"></i>
        </a>
        {{/actionurl}}
    </div>
    {{/checks}}
</div>
